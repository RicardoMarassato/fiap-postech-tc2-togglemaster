# Copy this file to .env and fill in your real AWS credentials.
# Do NOT commit the .env file to git.

AWS_REGION=us-east-1
AWS_SQS_URL=https://sqs.us-east-1.amazonaws.com/000000000000/togglemaster-events
AWS_DYNAMODB_TABLE=ToggleMasterAnalytics
